# ── Obligatorias ─────────────────────────────────────────────
# Contraseña del panel docente (/docente). Use una frase larga.
TEACHER_PASSWORD=cambie-esta-contraseña
# Secreto para firmar la sesión docente. Genere uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Opcionales ───────────────────────────────────────────────
PORT=3000
DATA_DIR=/app/data
# URL pública (para el código QR). Si se omite, se usa el host de la petición.
PUBLIC_URL=https://raula.sudominio.com
# Horas que dura la sesión docente
SESSION_HOURS=12
# Máximo de estudiantes conectados por aula
MAX_STUDENTS_PER_ROOM=150
# Paquetes que se registran en cada aula nueva (separados por coma)
DEFAULT_PACKAGES=
# webR: por defecto se sirve desde este mismo servidor (/vendor/webr/).
# Para usar el CDN oficial (menos carga para el VPS):
#   WEBR_BASE_URL=https://webr.r-wasm.org/v0.6.0/
WEBR_BASE_URL=/vendor/webr/
WEBR_REPO_URL=https://repo.r-wasm.org/
